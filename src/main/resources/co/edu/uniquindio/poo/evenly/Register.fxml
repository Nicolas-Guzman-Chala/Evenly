<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<StackPane prefHeight="618.0" prefWidth="1600.0" style="-fx-background-color: linear-gradient(to bottom right, #09090F, #0F172A);" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.uniquindio.poo.evenly.RegisterController">

    <children>

        <AnchorPane maxHeight="898.0" maxWidth="1450.0" prefHeight="898.0" prefWidth="1450.0" style="-fx-background-color: #0B1120;                            -fx-background-radius: 30;                            -fx-border-radius: 30;                            -fx-border-color: #262B44;                            -fx-border-width: 1;">

            <children>

                <!-- LEFT PANEL -->

                <AnchorPane layoutX="52.0" layoutY="46.0" prefHeight="130.0" prefWidth="500.0" style="-fx-background-radius: 25;                                    -fx-background-color: linear-gradient(to bottom,                                    rgba(168,85,247,0.45),                                    rgba(15,23,42,0.95));">

                    <children>

                        <ImageView fitHeight="230.0" fitWidth="500.0" layoutY="20.0" opacity="0.55" preserveRatio="false">

                        </ImageView>

                        <Label layoutX="103.0" layoutY="173.0" text="Join the&#10;Evenly&#10;Experience" textFill="WHITE">

                            <font>
                                <Font name="Poppins Bold" size="50.0" />
                            </font>

                        </Label>

                        <Line endX="70.0" layoutX="75.0" layoutY="401.0" stroke="#C026D3" strokeWidth="4" />

                        <Label layoutX="73.0" layoutY="445.0" prefWidth="350.0" style="-fx-text-fill: #B8C1D9;" text="Create your account and discover the best events, buy your tickets and live unforgettable experiences." wrapText="true">

                            <font>
                                <Font name="Poppins Regular" size="18.0" />
                            </font>

                        </Label>

                        <VBox layoutX="70.0" layoutY="670.0" spacing="25.0">

                            <children>

                                <HBox spacing="15.0">

                                    <children>

                                        <ImageView fitHeight="28.0" fitWidth="28.0">

                                        </ImageView>

                                        <VBox spacing="4.0" />

                                    </children>

                                </HBox>

                            </children>

                        </VBox>
                  <ImageView fitHeight="102.0" fitWidth="316.0" layoutX="19.0" layoutY="52.0" pickOnBounds="true" preserveRatio="true">
                     <image>
                        <Image url="@imgs/EvenlyLogo.png" />
                     </image>
                  </ImageView>

                        <Label layoutX="125.0" layoutY="69.0" prefHeight="60.0" prefWidth="181.0" text="EVENLY" textFill="WHITE">

                            <font>
                                <Font name="Poppins Bold" size="44.0" />
                            </font>

                        </Label>

                              <Label layoutX="125.0" layoutY="591.0" text="Access to events" textFill="WHITE">

                                  <font>
                                      <Font name="Poppins SemiBold" size="16.0" />
                                  </font>

                              </Label>

                              <Label layoutX="125.0" layoutY="618.0" style="-fx-text-fill: #9CA3AF;" text="The best events in one place." />
                  <Line endX="70.0" layoutX="75.0" layoutY="173.0" stroke="#C026D3" strokeWidth="4" />
                  <Circle fill="#a751ab" layoutX="48.0" layoutY="34.0" onMouseClicked="#onChangeHome" radius="29.0" stroke="WHITE" strokeType="INSIDE" />
                  <Label layoutX="27.0" layoutY="-10.0" onMouseClicked="#onChangeHome" prefHeight="77.0" prefWidth="43.0" text="&lt;" textFill="WHITE">
                     <font>
                        <Font name="Calibri" size="77.0" />
                     </font>
                  </Label>

                    </children>

                </AnchorPane>

                <!-- RIGHT PANEL -->

                <AnchorPane layoutX="560.0" layoutY="40.0" prefHeight="740.0" prefWidth="820.0">

                    <children>

                        <Label layoutX="181.0" layoutY="38.0" text="Create your account" textFill="WHITE">

                            <font>
                                <Font name="Poppins Bold" size="42.0" />
                            </font>

                        </Label>

                        <Label layoutX="187.0" layoutY="110.0" style="-fx-text-fill: #9CA3AF;" text="Complete your information to register in Evenly">

                            <font>
                                <Font name="Poppins Regular" size="18.0" />
                            </font>

                        </Label>

                        <!-- NAME -->

                        <Label layoutX="40.0" layoutY="150.0" text="Full name" textFill="WHITE">

                            <font>
                                <Font name="Poppins Medium" size="16.0" />
                            </font>

                        </Label>

                        <TextField fx:id="inputFullName" layoutX="43.0" layoutY="175.0" prefHeight="55.0" prefWidth="700.0" promptText="Enter your full name" style="-fx-background-color: #111827;                                           -fx-background-radius: 15;                                           -fx-border-radius: 15;                                           -fx-border-color: #2A324B;                                           -fx-text-fill: white;                                           -fx-prompt-text-fill: #6B7280;                                           -fx-font-size: 16;" />

                        <!-- EMAIL -->

                        <Label layoutX="40.0" layoutY="240.0" text="Email" textFill="WHITE">

                            <font>
                                <Font name="Poppins Medium" size="16.0" />
                            </font>

                        </Label>

                        <TextField fx:id="inputEmail" layoutX="40.0" layoutY="270.0" prefHeight="55.0" prefWidth="700.0" promptText="example@email.com" style="-fx-background-color: #111827;                                           -fx-background-radius: 15;                                           -fx-border-radius: 15;                                           -fx-border-color: #2A324B;                                           -fx-text-fill: white;                                           -fx-prompt-text-fill: #6B7280;                                           -fx-font-size: 16;" />

                        <!-- PASSWORD -->

                        <Label layoutX="40.0" layoutY="337.0" text="Password" textFill="WHITE">

                            <font>
                                <Font name="Poppins Medium" size="16.0" />
                            </font>

                        </Label>

                        <PasswordField fx:id="inputPassword" layoutX="40.0" layoutY="367.0" prefHeight="55.0" prefWidth="700.0" promptText="Create a password" style="-fx-background-color: #111827;                                               -fx-background-radius: 15;                                               -fx-border-radius: 15;                                               -fx-border-color: #2A324B;                                               -fx-text-fill: white;                                               -fx-prompt-text-fill: #6B7280;                                               -fx-font-size: 16;" />

                        <!-- DATE -->

                        <Label layoutX="40.0" layoutY="431.0" text="Phone Number" textFill="WHITE">

                            <font>
                                <Font name="Poppins Medium" size="16.0" />
                            </font>

                        </Label>

                        <!-- TERMS -->

                        <CheckBox fx:id="onAcept" layoutX="40.0" layoutY="533.0" text="I accept terms and conditions" textFill="#D1D5DB">

                            <font>
                                <Font name="Poppins Regular" size="14.0" />
                            </font>

                        </CheckBox>

                        <!-- BUTTON -->

                        <Button layoutX="40.0" layoutY="564.0" onAction="#onCreateAccount" prefHeight="60.0" prefWidth="700.0" style="-fx-background-color: linear-gradient(to right, #D946EF, #9333EA);                                        -fx-background-radius: 18;                                        -fx-text-fill: white;                                        -fx-font-size: 20;                                        -fx-font-family: 'Poppins SemiBold';" text="Create account">
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor></Button>
                  <PasswordField fx:id="inputPhoneNumber" layoutX="40.0" layoutY="463.0" prefHeight="55.0" prefWidth="700.0" promptText="Enter your phone number" style="-fx-background-color: #111827;                                               -fx-background-radius: 15;                                               -fx-border-radius: 15;                                               -fx-border-color: #2A324B;                                               -fx-text-fill: white;                                               -fx-prompt-text-fill: #6B7280;                                               -fx-font-size: 16;" />
                  <Label layoutX="40.0" layoutY="640.0" style="-fx-text-fill: #9CA3AF;" text="Do you have an account?">
                     <font>
                        <Font name="Poppins Regular" size="18.0" />
                     </font>
                  </Label>
                  <Label layoutX="278.0" layoutY="640.0" onMouseClicked="#onChangeLogin" text="Login" textFill="#cc43d3">
                     <font>
                        <Font name="Poppins Regular" size="18.0" />
                     </font>
                     <cursor>
                        <Cursor fx:constant="HAND" />
                     </cursor>
                  </Label>

                    </children>

                </AnchorPane>

            </children>

        </AnchorPane>

    </children>

</StackPane>
